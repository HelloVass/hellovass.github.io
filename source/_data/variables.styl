// Custom color scheme — Kotlin brand purple
$body-bg-color = #f5f5f7
$content-bg-color = #fff
$text-color = #2b2b2b
$link-color = #7F52FF
$link-hover-color = darken($link-color, 12%)

// Font stacks
$font-family-base = "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif
$font-family-headings = $font-family-base
$font-family-monospace = "Fira Code", "Source Code Pro", "Menlo", "Consolas", monospace
