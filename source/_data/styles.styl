// Post card style
.post-block {
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  padding: 20px 30px;
  margin-bottom: 20px;
}

// Code block rounded corners
.highlight, pre {
  border-radius: 6px;
}

// Sidebar avatar
.site-author-image {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  object-fit: cover;
  width: 96px;
  height: 96px;
}

// Show subtitle (hidden by Mist scheme)
.site-subtitle {
  display: block !important;
  font-size: 0.8em;
  color: #999;
  margin-top: 4px;
}

// Smooth link transition
a {
  transition: color 0.2s ease-in-out;
}

